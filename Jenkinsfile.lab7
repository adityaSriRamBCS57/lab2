pipeline {
    agent any

    environment {
        IMAGE = "adityasr57/wine_predict_2022bcs0057:latest"
        CONTAINER = "wine_test_container"
        API_URL = "http://localhost:8000/predict"
    }

    stages {

        stage('Pull Image') {
            steps {
                sh '''
                echo "Pulling latest Docker image..."
                docker pull $IMAGE
                '''
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                echo "Starting container..."
                docker rm -f $CONTAINER || true

                docker run -d \
                  -p 8000:8000 \
                  --name $CONTAINER \
                  $IMAGE

                docker ps
                '''
            }
        }

        stage('Wait for API Readiness') {
            steps {
                sh '''
                echo "Waiting for API to start..."

                for i in {1..20}
                do
                    if curl -s http://localhost:8000/docs > /dev/null; then
                        echo "API is ready"
                        exit 0
                    fi

                    echo "Waiting..."
                    sleep 2
                done

                echo "API did not start in time"
                docker logs $CONTAINER
                exit 1
                '''
            }
        }

        stage('Send Valid Inference Request') {
            steps {
                sh '''
                echo "Sending valid inference request..."

                RESPONSE=$(curl -s -X POST $API_URL \
                    -H "Content-Type: application/json" \
                    -d "$(jq -c .valid test_inputs.json)")

                echo "API response:"
                echo $RESPONSE

                echo $RESPONSE | jq '.'

                echo $RESPONSE | jq -e '.wine_quality' > /dev/null

                echo "Valid request check passed"
                '''
            }
        }

        stage('Send Invalid Request') {
            steps {
                sh '''
                echo "Sending invalid request..."

                STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
                    -X POST $API_URL \
                    -H "Content-Type: application/json" \
                    -d "$(jq -c .invalid test_inputs.json)")

                echo "Returned HTTP status: $STATUS"

                if [ "$STATUS" -eq 200 ]; then
                    echo "Invalid request should not succeed!"
                    exit 1
                fi

                echo "Invalid request correctly rejected"
                '''
            }
        }
    }

    post {

        always {
            sh '''
            echo "Cleaning up container..."
            docker stop $CONTAINER || true
            docker rm $CONTAINER || true
            docker ps
            '''
        }

        success {
            echo "Pipeline completed successfully: model inference validated."
        }

        failure {
            echo "Pipeline failed: validation checks did not pass."
        }
    }
}